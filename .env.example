# LLM and tracing
GOOGLE_API_KEY=
LLM_MODEL=gemini-2.5-flash
LANGSMITH_API_KEY=

# Shared MCP network settings
MCP_HOST=127.0.0.1
MCP_TRANSPORT=streamable-http

# Weather MCP: http://127.0.0.1:8000/mcp
WEATHER_MCP_ENABLED=true
WEATHER_MCP_HOST=127.0.0.1
WEATHER_MCP_PORT=8000
WEATHER_MCP_URL=http://127.0.0.1:8000/mcp

# Email MCP: http://127.0.0.1:8001/mcp
EMAIL_MCP_ENABLED=true
EMAIL_MCP_HOST=127.0.0.1
EMAIL_MCP_PORT=8001
EMAIL_MCP_URL=http://127.0.0.1:8001/mcp
EMAIL_ADDRESS=
EMAIL_APP_PASSWORD=
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USE_TLS=true
MAX_RECIPIENTS_PER_CALL=20
MAX_ATTACHMENT_MB=20
DEFAULT_DISPLAY_NAME=

# Personal Memory MCP: http://127.0.0.1:8003/mcp
PERSONAL_MEMORY_MCP_ENABLED=true
PERSONAL_MEMORY_MCP_HOST=127.0.0.1
PERSONAL_MEMORY_MCP_PORT=8003
PERSONAL_MEMORY_MCP_URL=http://127.0.0.1:8003/mcp

# Personal Memory upload API (not MCP): http://127.0.0.1:8002
PERSONAL_MEMORY_API_HOST=127.0.0.1
PERSONAL_MEMORY_API_PORT=8002

# Filesystem MCP: http://127.0.0.1:8004/mcp
FILESYSTEM_MCP_ENABLED=true
FILESYSTEM_MCP_HOST=127.0.0.1
FILESYSTEM_MCP_PORT=8004
FILESYSTEM_MCP_URL=http://127.0.0.1:8004/mcp
FILESYSTEM_ALLOWED_ROOTS=.

# Database MCP: http://127.0.0.1:8005/mcp
DATABASE_MCP_ENABLED=true
DATABASE_MCP_HOST=127.0.0.1
DATABASE_MCP_PORT=8005
DATABASE_MCP_URL=http://127.0.0.1:8005/mcp
DATABASE_PATH=data/assistant.db

# LangGraph conversation persistence
CHECKPOINT_DATABASE_PATH=data/checkpoints.sqlite
